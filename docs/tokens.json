{
  "$description": "PDF-bagaren – designtokens i W3C DTCG-format. Färger och typsnitt ur GP MS (Grafisk profil materielsystem, version 2026-11-12). Mörkt tema är standard; ljust tema anges under $extensions.modes.ljus. Avstånd, radier, storlekar och rörelse är tillägg för appen (se docs/design.md §9).",
  "color": {
    "gp": {
      "$description": "GP MS grundpalett. Används bara via ui-tokens i appen.",
      "sten-ljus": { "$type": "color", "$value": "#eceae6" },
      "sten": { "$type": "color", "$value": "#d4d5ce" },
      "grafit": { "$type": "color", "$value": "#74776f" },
      "skiffer": { "$type": "color", "$value": "#484b43" },
      "orange": { "$type": "color", "$value": "#df5411" },
      "gul": { "$type": "color", "$value": "#ffdd00" },
      "petrol": { "$type": "color", "$value": "#003d4c" },
      "gron": { "$type": "color", "$value": "#007167" },
      "vit": { "$type": "color", "$value": "#ffffff" }
    },
    "ui": {
      "bakgrund": { "$type": "color", "$value": "{color.gp.skiffer}", "$description": "Sidbakgrund.", "$extensions": { "modes": { "ljus": "{color.gp.sten-ljus}" } } },
      "yta": { "$type": "color", "$value": "{color.gp.petrol}", "$description": "Kolumner, paneler, dialoger.", "$extensions": { "modes": { "ljus": "{color.gp.sten}" } } },
      "text": { "$type": "color", "$value": "{color.gp.sten-ljus}", "$description": "All text. Mörkt 7,4:1 på bakgrund, 9,9:1 på yta. Ljust 7,4:1 / 6,0:1.", "$extensions": { "modes": { "ljus": "{color.gp.skiffer}" } } },
      "text-dampad": { "$type": "color", "$value": "{color.gp.sten}", "$description": "Hjälptext och metadata. Mörkt 6,0:1 / 8,0:1.", "$extensions": { "modes": { "ljus": "{color.gp.skiffer}" } } },
      "kant": { "$type": "color", "$value": "{color.gp.sten}", "$description": "Kanter på fält och kontroller (≥3:1). Mörkt 6,0:1 / 8,0:1. Ljust 3,8:1 / 3,1:1.", "$extensions": { "modes": { "ljus": "{color.gp.grafit}" } } },
      "avdelare": { "$type": "color", "$value": "{color.gp.grafit}", "$description": "Dekorativa linjer mellan områden. Bär aldrig betydelse.", "$extensions": { "modes": { "ljus": "{color.gp.sten}" } } },
      "primar": { "$type": "color", "$value": "{color.gp.gron}", "$description": "Primär knapp, en per vy.", "$extensions": { "modes": { "ljus": "{color.gp.gron}" } } },
      "primar-text": { "$type": "color", "$value": "{color.gp.vit}", "$description": "Text på primar (5,9:1).", "$extensions": { "modes": { "ljus": "{color.gp.vit}" } } },
      "fokus": { "$type": "color", "$value": "{color.gp.gul}", "$description": "Fokusring. Mörkt 6,6:1 / 8,8:1. Ljust petrol 9,9:1.", "$extensions": { "modes": { "ljus": "{color.gp.petrol}" } } },
      "markering": { "$type": "color", "$value": "{color.gp.gul}", "$description": "Varningar och vald status, alltid med text eller ikon. Ljust: bara grafik.", "$extensions": { "modes": { "ljus": "{color.gp.orange}" } } },
      "markering-text": { "$type": "color", "$value": "{color.gp.skiffer}", "$description": "Text på markering när den används som yta (mörkt: skiffer på gul 6,6:1; ljust: vit på orange bara stor/fet text 3,9:1).", "$extensions": { "modes": { "ljus": "{color.gp.vit}" } } },
      "fel": { "$type": "color", "$value": "{color.gp.orange}", "$description": "Ikon och ram för felmeddelanden. Bara grafik: 3,1:1 på petrol (mörkt), 3,2:1 på sten-ljus (ljust). Står alltid på fel-yta.", "$extensions": { "modes": { "ljus": "{color.gp.orange}" } } },
      "fel-yta": { "$type": "color", "$value": "{color.gp.petrol}", "$description": "Bakgrund för felmeddelanden.", "$extensions": { "modes": { "ljus": "{color.gp.sten-ljus}" } } },
      "valt": { "$type": "color", "$value": "{color.gp.gron}", "$description": "Bakgrund för märket 'Vald' på miniatyrer och aktiv flik, med primar-text.", "$extensions": { "modes": { "ljus": "{color.gp.gron}" } } },
      "sidyta": { "$type": "color", "$value": "{color.gp.grafit}", "$description": "Bakgrunden runt den förhandsvisade sidan, så att sidkanten syns.", "$extensions": { "modes": { "ljus": "{color.gp.grafit}" } } },
      "marginal-a": { "$type": "color", "$value": "{color.gp.petrol}", "$description": "Säkerhetsmarginalen i förhandsvisningen ritas streckad i två färger (a och b) så att den syns på både ljusa och mörka sidor.", "$extensions": { "modes": { "ljus": "{color.gp.petrol}" } } },
      "marginal-b": { "$type": "color", "$value": "{color.gp.gul}", "$extensions": { "modes": { "ljus": "{color.gp.gul}" } } }
    },
    "etikett": {
      "$description": "Förvalda färger för textetikettens text och bakgrund (FR-TXT-005/006). Gäller resultatet, inte gränssnittet; GP MS styr inte etiketter.",
      "svart": { "$type": "color", "$value": "#000000" },
      "vit": { "$type": "color", "$value": "#ffffff" },
      "gra": { "$type": "color", "$value": "#74776f" },
      "rod": { "$type": "color", "$value": "#c00000" },
      "bla": { "$type": "color", "$value": "#003d4c" },
      "gron": { "$type": "color", "$value": "#007167" },
      "gul": { "$type": "color", "$value": "#ffdd00" },
      "orange": { "$type": "color", "$value": "#df5411" }
    }
  },
  "font": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": ["Calibri", "Carlito", "Segoe UI", "Arial", "sans-serif"], "$description": "Gränssnittet. Carlito inbakad (OFL), Calibri bäddas aldrig in." },
      "etikett-sans": { "$type": "fontFamily", "$value": ["Carlito"], "$description": "Etikett: förval." },
      "etikett-serif": { "$type": "fontFamily", "$value": ["Tinos"], "$description": "Etikett med seriffer. Tinos är formen som Liberation Serif 2 bygger på (ADR-007, avvikelse i FEAT-007)." },
      "etikett-mono": { "$type": "fontFamily", "$value": ["Cousine"], "$description": "Etikett med fast teckenbredd. Cousine är formen som Liberation Mono 2 bygger på." }
    },
    "weight": {
      "normal": { "$type": "fontWeight", "$value": 400 },
      "fet": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "rubrik": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "32px", "lineHeight": "38px", "fontWeight": 700 }, "$description": "GP MS rubrik. Bara i hjälp och om-sida; arbetsytan har ingen stor rubrik." },
    "mellanrubrik": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "22px", "lineHeight": "28px", "fontWeight": 700 }, "$description": "GP MS mellanrubrik: dialogrubriker." },
    "kolumnrubrik": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "18px", "lineHeight": "24px", "fontWeight": 700 }, "$description": "Tillägg: rubrik för kolumner och paneler (1 Filer, 2 Resultat, 3 Märkning)." },
    "ingress": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "18px", "lineHeight": "26px", "fontWeight": 700, "fontStyle": "italic" }, "$description": "GP MS ingress: startytans budskap." },
    "ingress-latt": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "18px", "lineHeight": "26px", "fontWeight": 400, "fontStyle": "italic" }, "$description": "GP MS lätt ingress: instruktion i släppytan." },
    "brodtext": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 }, "$description": "GP MS brödtext: all text, fältetiketter, knapptext." },
    "liten": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 }, "$description": "Tillägg: miniatyrernas namn och sidnummer, metadata. Lägsta storlek i appen." }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "liten": { "$type": "dimension", "$value": "2px", "$description": "Miniatyrer." },
    "kontroll": { "$type": "dimension", "$value": "4px", "$description": "Knappar, fält, märken." },
    "panel": { "$type": "dimension", "$value": "8px", "$description": "Kolumner, dialoger, meddelanden." }
  },
  "size": {
    "kontroll-hojd": { "$type": "dimension", "$value": "40px" },
    "kontroll-min": { "$type": "dimension", "$value": "32px", "$description": "Minsta klickyta, även ikonknappar." },
    "fokus-bredd": { "$type": "dimension", "$value": "3px" },
    "fokus-avstand": { "$type": "dimension", "$value": "2px" },
    "kant-bredd": { "$type": "dimension", "$value": "2px" },
    "ikon": { "$type": "dimension", "$value": "20px" },
    "sidhuvud-hojd": { "$type": "dimension", "$value": "56px" },
    "kolumn-filer": { "$type": "dimension", "$value": "300px" },
    "kolumn-markning": { "$type": "dimension", "$value": "340px" },
    "resultatrad-hojd": { "$type": "dimension", "$value": "152px" },
    "miniatyr-bredd": { "$type": "dimension", "$value": "88px" }
  },
  "duration": {
    "snabb": { "$type": "duration", "$value": "150ms", "$description": "Hover, flikbyte. 0 ms vid prefers-reduced-motion." }
  }
}
