{
  "name": "pdf-bagaren",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens-till-css.mjs && node scripts/om-data.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc -b && vite build && node scripts/efter-bygge.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "prelint": "npm run tokens",
    "lint": "eslint .",
    "typkontroll": "npm run tokens && tsc -b",
    "test:enhet": "npm run tokens && vitest run",
    "test:e2e": "playwright test",
    "verapdf": "node scripts/verapdf.mjs",
    "licenser": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;(MIT AND Zlib);Zlib;OFL-1.1;CC0-1.0\"",
    "sarbarheter": "npm audit --omit=dev --audit-level=high",
    "test": "npm run lint && npm run test:enhet && npm run build && npm run licenser && npm run test:e2e"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@pdf-lib/fontkit": "1.1.1",
    "pdfjs-dist": "6.5.438",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "license-checker-rseidelsohn": "4.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
